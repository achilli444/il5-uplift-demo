header merging in ``starlette.responses.FileResponse``","cvss":[{"type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","metrics":{"baseScore":7.5,"exploitabilityScore":3.9,"impactScore":3.6},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2025-62727","epss":0.008,"percentile":0.563,"date":"2026-10-26"}],"cwes":[{"cve":"CVE-2025-62727","cwe":"CWE-407","source":"security-advisories@github.com","type":"Secondary"}],"fix":{"versions":["0.49.1"],"state":"fixed","available":[{"version":"0.49.1","date":"2025-10-29","kind":"first-observed"}]},"advisories":[],"risk":0.6},"relatedVulnerabilities":[{"id":"CVE-2025-62727","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2025-62727","namespace":"nvd:cpe","severity":"High","urls":["https://github.com/Kludex/starlette/commit/4ea6e22b489ec388d6004cfbca52dd5b147127c5","https://github.com/Kludex/starlette/commit/69ed26a85956ef4bd0161807eb27abf49be7cd3c","https://github.com/Kludex/starlette/releases/tag/0.49.1","https://github.com/Kludex/starlette/security/advisories/GHSA-7f5h-v6xp-fcq8"],"description":"Starlette is a lightweight ASGI framework/toolkit. Starting in version 0.39.0 and prior to version 0.49.1 , an unauthenticated attacker can send a crafted HTTP Range header that triggers quadratic-time processing in Starlette's FileResponse Range parsing/merging logic. This enables CPU exhaustion per request, causing denial‑of‑service for endpoints serving files (e.g., StaticFiles or any use of FileResponse). This vulnerability is fixed in 0.49.1.","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","metrics":{"baseScore":7.5,"exploitabilityScore":3.9,"impactScore":3.6},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2025-62727","epss":0.008,"percentile":0.563,"date":"2026-10-26"}],"cwes":[{"cve":"CVE-2025-62727","cwe":"CWE-407","source":"security-advisories@github.com","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"python-matcher","searchedBy":{"language":"python","namespace":"github:language:python","package":{"name":"starlette","version":"0.41.3"}},"found":{"vulnerabilityID":"GHSA-7f5h-v6xp-fcq8","versionConstraint":">=0.39.0,<=0.49.0 (python)"},"fix":{"suggestedVersion":"0.49.1"}}],"artifact":{"id":"pkg:pypi/starlette@0.41.3?package-id=dc857fe6a49a7d1d","name":"starlette","version":"0.41.3","type":"python","locations":[{"path":"/requirements-resolved.txt","accessPath":""}],"language":"python","licenses":[],"cpes":["cpe:2.3:a:encode:starlette:0.41.3:*:*:*:*:python:*:*"],"purl":"pkg:pypi/starlette@0.41.3","upstreams":[]}},{"vulnerability":{"id":"GHSA-82w8-qh3p-5jfq","dataSource":"https://github.com/advisories/GHSA-82w8-qh3p-5jfq","namespace":"github:language:python","severity":"High","urls":["https://github.com/Kludex/starlette/security/advisories/GHSA-82w8-qh3p-5jfq"],"description":"Starlette: request.form() limits silently ignored for application/x-www-form-urlencoded enable DoS","cvss":[{"type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","metrics":{"baseScore":7.5,"exploitabilityScore":3.9,"impactScore":3.6},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-54283","epss":0.00481,"percentile":0.41186,"date":"2026-10-26"}],"cwes":[{"cve":"CVE-2026-54283","cwe":"CWE-770","source":"security-advisories@github.com","type":"Secondary"}],"fix":{"versions":["1.3.1"],"state":"fixed","available":[{"version":"1.3.1","date":"2026-06-16","kind":"first-observed"}]},"advisories":[],"risk":0.36075},"relatedVulnerabilities":[{"id":"CVE-2026-54283","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2026-54283","namespace":"nvd:cpe","severity":"High","urls":["https://github.com/Kludex/starlette/security/advisories/GHSA-82w8-qh3p-5jfq"],"description":"Starlette is a lightweight ASGI framework/toolkit. From 0.4.1 until 1.3.1, request.form() accepts max_fields and max_part_size to bound resource consumption while parsing form data. These limits are enforced for multipart/form-data, but silently ignored for application/x-www-form-urlencoded. An unauthenticated attacker can therefore send a urlencoded body with an arbitrarily large number of fields or an arbitrarily large field, even when the application configured limits it believed would apply. This vulnerability is fixed in 1.3.1.","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","metrics":{"baseScore":7.5,"exploitabilityScore":3.9,"impactScore":3.6},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-54283","epss":0.00481,"percentile":0.41186,"date":"2026-10-26"}],"cwes":[{"cve":"CVE-2026-54283","cwe":"CWE-770","source":"security-advisories@github.com","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"python-matcher","searchedBy":{"language":"python","namespace":"github:language:python","package":{"name":"starlette","version":"0.41.3"}},"found":{"vulnerabilityID":"GHSA-82w8-qh3p-5jfq","versionConstraint":">=0.4.1,<1.3.1 (python)"},"fix":{"suggestedVersion":"1.3.1"}}],"artifact":{"id":"pkg:pypi/starlette@0.41.3?package-id=dc857fe6a49a7d1d","name":"starlette","version":"0.41.3","type":"python","locations":[{"path":"/requirements-resolved.txt","accessPath":""}],"language":"python","licenses":[],"cpes":["cpe:2.3:a:encode:starlette:0.41.3:*:*:*:*:python:*:*"],"purl":"pkg:pypi/starlette@0.41.3","upstreams":[]}},{"vulnerability":{"id":"GHSA-2c2j-9gv5-cj73","dataSource":"https://github.com/advisories/GHSA-2c2j-9gv5-cj73","namespace":"github:language:python","severity":"Medium","urls":["https://github.com/encode/starlette/security/advisories/GHSA-2c2j-9gv5-cj73","https://github.com/encode/starlette/commit/9f7ec2eb512fcc3fe90b43cb9dd9e1d08696bec1","https://github.com/encode/starlette/blob/fa5355442753f794965ae1af0f87f9fec1b9a3de/starlette/datastructures.py#L436C5-L447C14","https://github.com/encode/starlette/discussions/2927#discussioncomment-13721403","https://nvd.nist.gov/vuln/detail/CVE-2025-54121"],"description":"Starlette has possible denial-of-service vector when parsing large files in multipart forms","cvss":[{"type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:L","metrics":{"baseScore":5.3,"exploitabilityScore":3.9,"impactScore":1.5},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2025-54121","epss":0.0066,"percentile":0.51284,"date":"2026-10-26"}],"cwes":[{"cve":"CVE-2025-54121","cwe":"CWE-770","source":"security-advisories@github.com","type":"Secondary"}],"fix":{"versions":["0.47.2"],"state":"fixed","available":[{"version":"0.47.2","date":"2025-07-22","kind":"first-observed"}]},"advisories":[],"risk":0.33990000000000004},"relatedVulnerabilities":[{"id":"CVE-2025-54121","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2025-54121","namespace":"nvd:cpe","severity":"Medium","urls":["https://github.com/encode/starlette/blob/fa5355442753f794965ae1af0f87f9fec1b9a3de/starlette/datastructures.py#L436C5-L447C14","https://github.com/encode/starlette/commit/9f7ec2eb512fcc3fe90b43cb9dd9e1d08696bec1","https://github.com/encode/starlette/discussions/2927#discussioncomment-13721403","https://github.com/encode/starlette/security/advisories/GHSA-2c2j-9gv5-cj73"],"description":"Starlette is a lightweight ASGI (Asynchronous Server Gateway Interface) framework/toolkit, designed for building async web services in Python. In versions 0.47.1 and below, when parsing a multi-part form with large files (greater than the default max spool size) starlette will block the main thread to roll the file over to disk. This blocks the event thread which means the application can't accept new connections. The UploadFile code has a minor bug where instead of just checking for self._in_memory, the logic should also check if the additional bytes will cause a rollover. The vulnerability is fixed in version 0.47.2.","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:L","metrics":{"baseScore":5.3,"exploitabilityScore":3.9,"impactScore":1.5},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2025-54121","epss":0.0066,"percentile":0.51284,"date":"2026-10-26"}],"cwes":[{"cve":"CVE-2025-54121","cwe":"CWE-770","source":"security-advisories@github.com","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"python-matcher","searchedBy":{"language":"python","namespace":"github:language:python","package":{"name":"starlette","version":"0.41.3"}},"found":{"vulnerabilityID":"GHSA-2c2j-9gv5-cj73","versionConstraint":"<0.47.2 (python)"},"fix":{"suggestedVersion":"0.47.2"}}],"artifact":{"id":"pkg:pypi/starlette@0.41.3?package-id=dc857fe6a49a7d1d","name":"starlette","version":"0.41.3","type":"python","locations":[{"path":"/requirements-resolved.txt","accessPath":""}],"language":"python","licenses":[],"cpes":["cpe:2.3:a:encode:starlette:0.41.3:*:*:*:*:python:*:*"],"purl":"pkg:pypi/starlette@0.41.3","upstreams":[]}},{"vulnerability":{"id":"GHSA-wqp7-x3pw-xc5r","dataSource":"https://github.com/advisories/GHSA-wqp7-x3pw-xc5r","namespace":"github:language:python","severity":"High","urls":["https://github.com/Kludex/starlette/security/advisories/GHSA-wqp7-x3pw-xc5r"],"description":"Starlette: SSRF and NTLM credential theft via UNC paths in StaticFiles on Windows","cvss":[{"type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:N/A:N","metrics":{"baseScore":7.5,"exploitabilityScore":3.9,"impactScore":3.6},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-48818","epss":0.00368,"percentile":0.30416,"date":"2026-10-26"}],"cwes":[{"cve":"CVE-2026-48818","cwe":"CWE-918","source":"security-advisories@github.com","type":"Secondary"},{"cve":"CVE-2026-48818","cwe":"CWE-918","source":"0b0ca135-0b70-47e7-9f44-1890c2a1c46c","type":"Secondary"}],"fix":{"versions":["1.1.0"],"state":"fixed","available":[{"version":"1.1.0","date":"2026-06-16","kind":"first-observed"}]},"advisories":[],"risk":0.276},"relatedVulnerabilities":[{"id":"CVE-2026-48818","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2026-48818","namespace":"nvd:cpe","severity":"High","urls":["https://github.com/Kludex/starlette/commit/fd53168a7767b6b55ba5af787fd88f49e33cabc5","https://github.com/Kludex/starlette/pull/3287","https://github.com/Kludex/starlette/releases/tag/1.1.0","https://github.com/Kludex/starlette/security/advisories/GHSA-wqp7-x3pw-xc5r","https://github.com/pypa/advisory-database/tree/main/vulns/starlette/PYSEC-2026-2281.yaml","https://access.redhat.com/errata/RHSA-2026:30087","https://access.redhat.com/errata/RHSA-2026:30088","https://access.redhat.com/errata/RHSA-2026:30089","https://access.redhat.com/security/cve/CVE-2026-48818","https://bugzilla.redhat.com/show_bug.cgi?id=2490020","https://security.access.redhat.com/data/csaf/v2/vex/2026/cve-2026-48818.json"],"description":"Starlette is a lightweight ASGI framework/toolkit. In versions 1.0.1 and earlier, StaticFiles on Windows is vulnerable to SSRF. An UNC path such as \\\\attacker.com\\share can cause os.path.realpath to initiate an outbound SMB connection before the path is rejected, exposing the service account’s NTLMv2 credentials for offline cracking or relay even though the HTTP response is only a 404. The issue affects default follow_symlink=False deployments, including frameworks built on Starlette such as FastAPI; POSIX systems and follow_symlink=True are unaffected. The issue is fixed in 1.1.0.","cvss":[{"source":"0b0ca135-0b70-47e7-9f44-1890c2a1c46c","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:N/A:N","metrics":{"baseScore":7.5,"exploitabilityScore":3.9,"impactScore":3.6},"vendorMetadata":{}},{"source":"security-advisories@github.com","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:N/A:N","metrics":{"baseScore":7.5,"exploitabilityScore":3.9,"impactScore":3.6},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-48818","epss":0.00368,"percentile":0.30416,"date":"2026-10-26"}],"cwes":[{"cve":"CVE-2026-48818","cwe":"CWE-918","source":"security-advisories@github.com","type":"Secondary"},{"cve":"CVE-2026-48818","cwe":"CWE-918","source":"0b0ca135-0b70-47e7-9f44-1890c2a1c46c","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"python-matcher","searchedBy":{"language":"python","namespace":"github:language:python","package":{"name":"starlette","version":"0.41.3"}},"found":{"vulnerabilityID":"GHSA-wqp7-x3pw-xc5r","versionConstraint":"<1.1.0 (python)"},"fix":{"suggestedVersion":"1.1.0"}}],"artifact":{"id":"pkg:pypi/starlette@0.41.3?package-id=dc857fe6a49a7d1d","name":"starlette","version":"0.41.3","type":"python","locations":[{"path":"/requirements-resolved.txt","accessPath":""}],"language":"python","licenses":[],"cpes":["cpe:2.3:a:encode:starlette:0.41.3:*:*:*:*:python:*:*"],"purl":"pkg:pypi/starlette@0.41.3","upstreams":[]}},{"vulnerability":{"id":"GHSA-x746-7m8f-x49c","dataSource":"https://github.com/advisories/GHSA-x746-7m8f-x49c","namespace":"github:language:python","severity":"Medium","urls":["https://github.com/Kludex/starlette/security/advisories/GHSA-x746-7m8f-x49c","https://nvd.nist.gov/vuln/detail/CVE-2026-48817","https://github.com/Kludex/starlette/releases/tag/1.1.0"],"description":"Starlette: Arbitrary HTTP method dispatched to `HTTPEndpoint` attributes via `getattr`","cvss":[{"type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:L/A:N","metrics":{"baseScore":5.3,"exploitabilityScore":3.9,"impactScore":1.5},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-48817","epss":0.00213,"percentile":0.11493,"date":"2026-10-26"}],"cwes":[{"cve":"CVE-2026-48817","cwe":"CWE-470","source":"security-advisories@github.com","type":"Secondary"}],"fix":{"versions":["1.1.0"],"state":"fixed","available":[{"version":"1.1.0","date":"2026-06-16","kind":"first-observed"}]},"advisories":[],"risk":0.109695},"relatedVulnerabilities":[{"id":"CVE-2026-48817","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2026-48817","namespace":"nvd:cpe","severity":"Medium","urls":["https://github.com/Kludex/starlette/releases/tag/1.1.0","https://github.com/Kludex/starlette/security/advisories/GHSA-x746-7m8f-x49c"],"description":"Starlette is a lightweight ASGI framework/toolkit. In versions 1.0.1 and below, when dispatching a request, HTTPEndpoint selects the handler by lowercasing the HTTP method and looking it up as an attribute with getattr, without restricting the lookup to a known set of HTTP verbs. When an HTTPEndpoint subclass is registered through Route(...) without an explicit methods= argument, the route does not constrain the method and every method reaches the endpoint. If a non-standard HTTP method whose lowercased name matches an attribute on the endpoint subclass reaches the endpoint, that attribute is invoked as if it were a request handler. An attacker can use this to reach methods that were never meant to be HTTP handlers, such as internal helpers, without the authorization checks applied by the intended public handler. An application (including Starlette-based frameworks like FastAPI) is affected if it registers an HTTPEndpoint subclass via Route(...) without explicitly setting methods=, and that subclass includes extra methods named like non-standard HTTP verbs that take one request argument and return a response. This issue has been fixed in version 1.1.0.","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:L/A:N","metrics":{"baseScore":5.3,"exploitabilityScore":3.9,"impactScore":1.5},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-48817","epss":0.00213,"percentile":0.11493,"date":"2026-10-26"}],"cwes":[{"cve":"CVE-2026-48817","cwe":"CWE-470","source":"security-advisories@github.com","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"python-matcher","searchedBy":{"language":"python","namespace":"github:language:python","package":{"name":"starlette","version":"0.41.3"}},"found":{"vulnerabilityID":"GHSA-x746-7m8f-x49c","versionConstraint":"<1.1.0 (python)"},"fix":{"suggestedVersion":"1.1.0"}}],"artifact":{"id":"pkg:pypi/starlette@0.41.3?package-id=dc857fe6a49a7d1d","name":"starlette","version":"0.41.3","type":"python","locations":[{"path":"/requirements-resolved.txt","accessPath":""}],"language":"python","licenses":[],"cpes":["cpe:2.3:a:encode:starlette:0.41.3:*:*:*:*:python:*:*"],"purl":"pkg:pypi/starlette@0.41.3","upstreams":[]}},{"vulnerability":{"id":"GHSA-jp82-jpqv-5vv3","dataSource":"https://github.com/advisories/GHSA-jp82-jpqv-5vv3","namespace":"github:language:python","severity":"Low","urls":["https://github.com/Kludex/starlette/security/advisories/GHSA-jp82-jpqv-5vv3","https://nvd.nist.gov/vuln/detail/CVE-2026-54282","https://github.com/pypa/advisory-database/tree/main/vulns/starlette/PYSEC-2026-248.yaml"],"description":"Starlette: Unvalidated request path concatenated into authority poisons request.url.hostname","cvss":[{"type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:N/I:L/A:N","metrics":{"baseScore":3.7,"exploitabilityScore":2.3,"impactScore":1.5},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-54282","epss":0.00273,"percentile":0.19513,"date":"2026-10-26"}],"cwes":[{"cve":"CVE-2026-54282","cwe":"CWE-706","source":"security-advisories@github.com","type":"Secondary"}],"fix":{"versions":["1.3.0"],"state":"fixed","available":[{"version":"1.3.0","date":"2026-06-16","kind":"first-observed"}]},"advisories":[],"risk":0.09145499999999998},"relatedVulnerabilities":[{"id":"CVE-2026-54282","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2026-54282","namespace":"nvd:cpe","severity":"Medium","urls":["https://github.com/Kludex/starlette/security/advisories/GHSA-jp82-jpqv-5vv3"],"description":"Starlette is a lightweight ASGI framework/toolkit. Prior to 1.3.0, the HTTP request path is not validated before being used to reconstruct request.url. Because request.url is rebuilt by concatenating {scheme}://{host}{path} and re-parsing the result, a path that does not begin with / (for example @google.com) moves the authority boundary during re-parsing, so request.url.hostname and request.url.netloc become attacker-controlled. Code that reads request.url.hostname (rather than the Host header or scope) can therefore be misled into trusting an attacker-supplied host. This vulnerability is fixed in 1.3.0.","cvss":[{"source":"nvd@nist.gov","type":"Primary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:L/A:N","metrics":{"baseScore":5.3,"exploitabilityScore":3.9,"impactScore":1.5},"vendorMetadata":{}},{"source":"security-advisories@github.com","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:N/I:L/A:N","metrics":{"baseScore":3.7,"exploitabilityScore":2.3,"impactScore":1.5},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-54282","epss":0.00273,"percentile":0.19513,"date":"2026-10-26"}],"cwes":[{"cve":"CVE-2026-54282","cwe":"CWE-706","source":"security-advisories@github.com","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"python-matcher","searchedBy":{"language":"python","namespace":"github:language:python","package":{"name":"starlette","version":"0.41.3"}},"found":{"vulnerabilityID":"GHSA-jp82-jpqv-5vv3","versionConstraint":"<1.3.0 (python)"},"fix":{"suggestedVersion":"1.3.0"}}],"artifact":{"id":"pkg:pypi/starlette@0.41.3?package-id=dc857fe6a49a7d1d","name":"starlette","version":"0.41.3","type":"python","locations":[{"path":"/requirements-resolved.txt","accessPath":""}],"language":"python","licenses":[],"cpes":["cpe:2.3:a:encode:starlette:0.41.3:*:*:*:*:python:*:*"],"purl":"pkg:pypi/starlette@0.41.3","upstreams":[]}},{"vulnerability":{"id":"GHSA-6w46-j5rx-g56g","dataSource":"https://github.com/advisories/GHSA-6w46-j5rx-g56g","namespace":"github:language:python","severity":"Medium","urls":["https://nvd.nist.gov/vuln/detail/CV